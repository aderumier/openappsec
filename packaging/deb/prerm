#!/bin/sh
# Hand removal to the payload's own uninstaller, which owns /etc/cp and the
# nano_agent service it created.
set -e

SHARE=/usr/share/openappsec

case "$1" in
    remove|deconfigure)
        if [ -x "$SHARE/agent/cp-agent-uninstall.sh" ]; then
            # Best effort: a failed uninstall must not wedge dpkg.
            "$SHARE/agent/cp-agent-uninstall.sh" || \
                echo "openappsec: uninstaller reported an error; check /etc/cp by hand" >&2
        fi
        ;;
    upgrade|failed-upgrade)
        # Leave the running agent alone; postinst reinstalls over it.
        ;;
esac

exit 0
