#!/bin/sh
# Run each pre-extracted payload's own installer. The payloads were unpacked at
# build time, so nothing self-extracts here and /tmp being noexec is irrelevant.
#
# The three inner scripts do NOT agree on argument handling, because makeself
# invokes them with the script's own name as $1:
#
#   orchestration_package.sh              parses args directly and ignores its
#                                         own name, so pass flags as-is
#   install-http-transaction-handler.sh   end with `shift; run "$@"`, so the
#   install-attachment-registration-...   first argument is discarded and a
#                                         placeholder has to precede the flags
#
# Getting this wrong is silent-ish: the shifting scripts print usage, exit 255.
set -e

SHARE=/usr/share/openappsec
DEFAULTS=/etc/default/openappsec

OPENAPPSEC_TOKEN=""
OPENAPPSEC_FOG=""
OPENAPPSEC_RESTART_NGINX=yes
[ -r "$DEFAULTS" ] && . "$DEFAULTS"

case "$1" in
    configure)
        # --token registers against the management portal; --hybrid_mode keeps
        # policy local. They are mutually exclusive.
        if [ -n "$OPENAPPSEC_TOKEN" ]; then
            set -- --install --token "$OPENAPPSEC_TOKEN"
            [ -n "$OPENAPPSEC_FOG" ] && set -- "$@" --fog "$OPENAPPSEC_FOG"
            echo "openappsec: registering with the management portal"
        else
            set -- --install --hybrid_mode
            echo "openappsec: local management (no token in $DEFAULTS)"
        fi

        ( cd "$SHARE/agent" && ./orchestration_package.sh "$@" )

        ( cd "$SHARE/http-transaction-handler" \
          && ./install-http-transaction-handler.sh \
                 ./install-http-transaction-handler.sh --install )

        ( cd "$SHARE/attachment-registration-manager" \
          && ./install-attachment-registration-manager.sh \
                 ./install-attachment-registration-manager.sh --install )

        # See OPENAPPSEC_RESTART_NGINX in /etc/default/openappsec for why.
        if [ "$OPENAPPSEC_RESTART_NGINX" = "yes" ] \
           && command -v systemctl >/dev/null 2>&1 \
           && systemctl is-active --quiet nginx 2>/dev/null; then
            echo "openappsec: restarting nginx so the attachment re-registers"
            systemctl restart nginx || \
                echo "openappsec: nginx restart failed - restart it by hand, or the WAF will fail open" >&2
        fi

        echo "openappsec: installed. Check with: open-appsec-ctl -s"
        echo "openappsec: the NGINX attachment is NOT part of this package - it is"
        echo "  compiled against one exact nginx build. Install it separately and"
        echo "  pin your nginx package so an upgrade cannot break the module."
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
esac

exit 0
